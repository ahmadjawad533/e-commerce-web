<!-- views/admin/partials/sidebar.ejs -->
<!-- Reusable sidebar included in every admin page -->

<aside class="admin-sidebar">

  <!-- Brand -->
  <div class="admin-brand">
    <a href="/admin">ENGINE</a>
    <span>Admin Panel</span>
  </div>

  <!-- Navigation links -->
  <nav class="admin-nav" aria-label="Admin navigation">
    <ul>
      <li>
        <a href="/admin" class="<%= locals.activePage === 'dashboard' ? 'active' : '' %>">
          <span class="nav-icon">▦</span> Dashboard
        </a>
      </li>
      <li>
        <a href="/admin/products/new" class="<%= locals.activePage === 'add' ? 'active' : '' %>">
