# ============================================================================
# Engine Fashion E-commerce - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# ============================================================================
# Server Configuration
# ============================================================================
PORT=3000
NODE_ENV=development

# ============================================================================
# MongoDB Database
# ============================================================================
# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/engine-fashion

# Or MongoDB Atlas (Cloud)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/engine-fashion?retryWrites=true&w=majority

# ============================================================================
# Authentication & Security
# ============================================================================
# Generate a strong secret key for JWT tokens
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here-change-this-in-production

# Session secret (if using express-session)
SESSION_SECRET=your-session-secret-here

# ============================================================================
# Optional: Email Service (for order notifications)
# ============================================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# ============================================================================
# Optional: Payment Gateway (Stripe, PayPal, etc.)
# ============================================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-secret

# ============================================================================
# Optional: Cloud Storage (AWS S3, Cloudinary, etc.)
# ============================================================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=engine-uploads

# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# Optional: API Keys
# ============================================================================
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# SENDGRID_API_KEY=your-sendgrid-key

# ============================================================================
# Development Settings
# ============================================================================
# Set to 'true' to enable debug logging
DEBUG=false

# Set to 'true' to seed database on startup
AUTO_SEED=false
